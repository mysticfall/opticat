{
  "name": "opticat",
  "description": "Functional programming API for writing games.",
  "author": {
    "name": "Xavier Cho",
    "email": "mysticfallband@gmail.com",
    "url": "https://github.com/mysticfall/opticat"
  },
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "opticat.umd.js",
  "module": "opticat.es.js",
  "types": "index.d.ts",
  "scripts": {
    "lint": "eslint .",
    "build": "vite build && tsc -p tsconfig.prod.json --emitDeclarationOnly && copyfiles package.json dist",
    "doc": "typedoc",
    "test": "vitest --no-watch",
    "coverage": "vitest --coverage --no-watch",
    "make-badges": "istanbul-badges-readme"
  },
  "dependencies": {
    "@fp-ts/optic": "^0.24.0",
    "fp-ts": "^2.16.9",
    "io-ts": "^2.2.21",
    "io-ts-numbers": "^1.1.1",
    "io-ts-types": "^0.5.19",
    "@langchain/core": "^0.2.28",
    "marked": "^14.0.0",
    "gray-matter": "^4.0.3",
    "html-entities": "^2.5.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^9.9.1",
    "typedoc": "^0.26.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5",
    "istanbul-badges-readme": "^1.9.0",
    "copyfiles": "^2.4.1",
    "husky": "^9.1.5"
  },
  "keywords": [
    "typescript",
    "game-framework",
    "functional-programming"
  ]
}
